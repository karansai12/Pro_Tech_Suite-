generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
}

model User {
  id String @id @default(uuid()) @db.Uuid
  firstName String
  lastName String
  email String @unique
  password String 
  role Role @default(EMPLOYEE)
  createdAt DateTime @default(now())
}
